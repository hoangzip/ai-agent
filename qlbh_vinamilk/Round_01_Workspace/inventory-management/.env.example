# ====================================================================
# TEMPLATE CẤU HÌNH BIẾN MÔI TRƯỜNG (.env.example)
# DỰ ÁN: Quản lý & Đối soát Tồn kho (Vinamilk)
# Ghi chú: KHÔNG điền trực tiếp giá trị secret thực tế vào file này.
# ====================================================================

# Cấu hình môi trường Worker
ENVIRONMENT=development
ROUND=03
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Bảo mật Khởi tạo Quản trị viên (Admin Bootstrap) - Bắt buộc để chạy /api/v1/system/bootstrap
BOOTSTRAP_TOKEN=your_secure_bootstrap_token_here_min_16_chars

# CORS Whitelist (phân tách bởi dấu phẩy)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Drive Sync (Round 07)
GDRIVE_FOLDER_ID=1HOsA7gWKghPVUcq2JgUhS9xgiccjp4bk

# Cloudflare D1 Local / Binding (Wrangler tự động nạp qua wrangler.toml)
# DB=inventory_management_d1

